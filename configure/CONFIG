# CONFIG - labpva build configuration
#
# EPICS-standard configure/ layout:
#   configure/RELEASE      external product paths (EPICS_BASE, MATLABDIR)
#   configure/CONFIG_APP   includes RELEASE + $(EPICS_BASE)/configure/CONFIG
#   configure/CONFIG_SITE  site-tunable build knobs (C++ std, PVA lib list, ...)
#   configure/CONFIG       this file: derived / mechanical settings
#
# labpva intentionally keeps a direct-`mex` build rather than the EPICS
# O.<arch>/PROD machinery (the MEX compile/link rules live in glue/Makefile and
# matlab/Makefile and read the variables assembled here). Adopting the standard
# configure/ file set is what lets EPICS_BASE live in configure/RELEASE and lets
# arch/compiler settings come from EPICS base, as in the labca reference build.

include $(TOP)/configure/CONFIG_APP
include $(TOP)/configure/CONFIG_SITE

# ---- MATLAB mex toolchain --------------------------------------------------
ifndef MATLABDIR
  $(error MATLABDIR is not defined -- set it in configure/RELEASE)
endif
MEX    = $(MATLABDIR)/bin/mex
MEXEXT = mexa64

# ---- EPICS include / lib locations -----------------------------------------
EPICS_INC = $(EPICS_BASE)/include
EPICS_LIB = $(EPICS_BASE)/lib/$(EPICS_HOST_ARCH)

# EPICS headers: include/ plus an OS and a compiler subdir.
EPICS_INCLUDES = -I$(EPICS_INC) \
                 -I$(EPICS_INC)/os/$(EPICS_OS_CLASS) \
                 -I$(EPICS_INC)/compiler/$(EPICS_CMPLR_CLASS)

# ---- pvAccess client backend selection --------------------------------------
# If PVXS is defined (configure/RELEASE), the glue is built against libpvxs
# (backend "pvxs"); otherwise against the classic pvaClient/pvAccessCPP stack
# (backend "pvac", the default). Backend-specific sources are
# glue/pvaGlue_$(LABPVA_BACKEND).cpp and glue/pvaConvert_$(LABPVA_BACKEND).cpp;
# everything else (mglue, pvaError, all MEX) is shared.
ifdef PVXS
  ifeq ($(wildcard $(PVXS)/include/pvxs/client.h),)
    $(error PVXS is set but $(PVXS)/include/pvxs/client.h was not found -- \
point PVXS at a BUILT pvxs tree)
  endif
  LABPVA_BACKEND   = pvxs
  BACKEND_CPPFLAGS = -DLABPVA_USE_PVXS
  EPICS_INCLUDES  += -I$(PVXS)/include
  PVA_LIBDIRS      = -L$(EPICS_LIB) -L$(PVXS)/lib/$(EPICS_HOST_ARCH)
  PVA_LIBS         = -lpvxs -lCom
  PVA_RPATH_DIRS   = $(EPICS_LIB) $(abspath $(PVXS)/lib/$(EPICS_HOST_ARCH))
else
  LABPVA_BACKEND   = pvac
  BACKEND_CPPFLAGS =
  PVA_LIBDIRS      = -L$(EPICS_LIB)
  PVA_LIBS         = $(LABPVA_PVA_LIBS)
  PVA_RPATH_DIRS   = $(EPICS_LIB)
endif
PVA_RPATH = $(foreach d,$(PVA_RPATH_DIRS),-Wl,-rpath,$(d))

# ---- assembled flags forwarded to mex --------------------------------------
CXXSTD       = $(LABPVA_CXXSTD)
MEX_CXXFLAGS = CXXFLAGS='$$CXXFLAGS -fPIC $(CXXSTD)'
MEX_LDFLAGS  = LDFLAGS='$$LDFLAGS $(PVA_RPATH)'

-include $(TOP)/configure/CONFIG.local
